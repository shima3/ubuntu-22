<Location "/jupyter">
    # ブラウザが叩いたドメイン名をそのまま JupyterHub に伝える
    ProxyPreserveHost On
    # retry=0: 失敗してもすぐ再試行する
    # timeout=30: タイムアウト設定（任意）
    # ProxyPass "/jupyter" "http://127.0.0.1:8000/jupyter" retry=0 timeout=30
    ProxyPass http://127.0.0.1:8000/jupyter retry=0 timeout=30
    # ProxyPassReverse は書き換え後の URL ではなく、バックエンドの「根っこ」を指定
    # ProxyPassReverse "/jupyter" "http://127.0.0.1:8000/jupyter"
    ProxyPassReverse http://127.0.0.1:8000/jupyter

    RewriteEngine On
    # 1. WebSocket のアップグレード要求（Upgrade: websocket）がある場合
    # [P] は Proxy、[L] は Last (ここで確定) を意味します
    RewriteCond %{HTTP:Upgrade} =websocket [NC]
    RewriteRule /(.*) ws://127.0.0.1:8000/jupyter/$1 [P,L]
    # 2. それ以外（通常の HTTP リクエスト）の場合
    RewriteCond %{HTTP:Upgrade} !=websocket [NC]
    RewriteRule /(.*) http://127.0.0.1:8000/jupyter/$1 [P,L]
</Location>
